{
  "name": "dotfetch",
  "displayName": "DotFetch",
  "description": "A professional HTTP client extension for VS Code with environment variables, collections, and cURL support",
  "version": "2.1.1",
  "publisher": "FreeRave",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/kareem2099/DotFetch.git"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "icon": "media/icon.png",
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "dotfetch.openRequestBuilder",
        "title": "New Request",
        "icon": "$(plus)"
      },
      {
        "command": "dotfetch.importCurl",
        "title": "Import cURL",
        "icon": "$(terminal)"
      },
      {
        "command": "dotfetch.saveRequest",
        "title": "Save Request",
        "icon": "$(save)"
      },
      {
        "command": "dotfetch.createCollection",
        "title": "New Collection",
        "icon": "$(add)"
      },
      {
        "command": "dotfetch.deleteCollection",
        "title": "Delete Collection",
        "icon": "$(trash)"
      },
      {
        "command": "dotfetch.deleteRequestFromCollection",
        "title": "Delete Request",
        "icon": "$(trash)"
      },
      {
        "command": "dotfetch.editRequestInCollection",
        "title": "Edit Request",
        "icon": "$(edit)"
      },
      {
        "command": "dotfetch.refreshCollections",
        "title": "Refresh Collections",
        "icon": "$(refresh)"
      },
      {
        "command": "dotfetch.refreshHistory",
        "title": "Refresh History",
        "icon": "$(refresh)"
      },
      {
        "command": "dotfetch.clearHistory",
        "title": "Clear History",
        "icon": "$(trash)"
      },
      {
        "command": "dotfetch.copyVariable",
        "title": "Copy Variable",
        "icon": "$(copy)"
      },
      {
        "command": "dotfetch.copyVariableName",
        "title": "Copy Variable Name"
      },
      {
        "command": "dotfetch.copyVariablePlaceholder",
        "title": "Copy as {{VARIABLE}}"
      },
      {
        "command": "dotfetch.searchVariable",
        "title": "Search Variable"
      },
      {
        "command": "dotfetch.showAllVariables",
        "title": "Show All Variables"
      },
      {
        "command": "dotfetch.setActiveEnvironment",
        "title": "Set as Active Environment",
        "icon": "$(check)"
      },
      {
        "command": "dotfetch.clearActiveEnvironment",
        "title": "Clear Active Environment",
        "icon": "$(circle-slash)"
      },
      {
        "command": "dotfetch.openEnvironmentFile",
        "title": "Open Environment File",
        "icon": "$(go-to-file)"
      },
      {
        "command": "dotfetch.refreshEnvironments",
        "title": "Refresh Environments",
        "icon": "$(refresh)"
      },
      {
        "command": "dotfetch.duplicateRequest",
        "title": "Duplicate Request",
        "icon": "$(copy)"
      },
      {
        "command": "dotfetch.newRequest",
        "title": "New Request",
        "icon": "$(add)"
      },
      {
        "command": "dotfetch.focusUrl",
        "title": "Focus URL Bar",
        "icon": "$(search)"
      },
      {
        "command": "dotfetch.sendRequest",
        "title": "Send Active Request",
        "icon": "$(send)"
      },
      {
        "command": "dotfetch.clearForm",
        "title": "Clear Request Form",
        "icon": "$(clear-all)"
      },
      {
        "command": "dotfetch.selectEnvironment",
        "title": "Select Environment",
        "icon": "$(symbol-variable)"
      }
    ],
    "keybindings": [
      {
        "command": "dotfetch.sendRequest",
        "key": "ctrl+enter",
        "mac": "cmd+enter",
        "when": "activeWebviewPanelId == dotfetchEditor"
      },
      {
        "command": "dotfetch.focusUrl",
        "key": "alt+d",
        "mac": "alt+d",
        "when": "activeWebviewPanelId == dotfetchEditor"
      },
      {
        "command": "dotfetch.saveRequest",
        "key": "ctrl+alt+s",
        "mac": "cmd+alt+s",
        "when": "activeWebviewPanelId == dotfetchEditor"
      },
      {
        "command": "dotfetch.clearForm",
        "key": "ctrl+shift+backspace",
        "mac": "cmd+shift+backspace",
        "when": "activeWebviewPanelId == dotfetchEditor"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "dotfetch.refreshEnvironments",
          "when": "view == dotfetchEnvironments",
          "group": "navigation"
        },
        {
          "command": "dotfetch.createCollection",
          "when": "view == dotfetchCollections",
          "group": "navigation@1"
        },
        {
          "command": "dotfetch.refreshCollections",
          "when": "view == dotfetchCollections",
          "group": "navigation@2"
        },
        {
          "command": "dotfetch.clearHistory",
          "when": "view == dotfetchHistory",
          "group": "navigation@1"
        },
        {
          "command": "dotfetch.refreshHistory",
          "when": "view == dotfetchHistory",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "dotfetch.copyVariable",
          "when": "view == dotfetchEnvironments && viewItem == environmentVariable",
          "group": "inline@1"
        },
        {
          "command": "dotfetch.copyVariableName",
          "when": "view == dotfetchEnvironments && viewItem == environmentVariable",
          "group": "copy@1"
        },
        {
          "command": "dotfetch.copyVariablePlaceholder",
          "when": "view == dotfetchEnvironments && viewItem == environmentVariable",
          "group": "copy@2"
        },
        {
          "command": "dotfetch.editRequestInCollection",
          "when": "view == dotfetchCollections && viewItem == collectionRequest",
          "group": "inline@1"
        },
        {
          "command": "dotfetch.duplicateRequest",
          "when": "view == dotfetchCollections && viewItem == collectionRequest",
          "group": "inline@2"
        },
        {
          "command": "dotfetch.deleteRequestFromCollection",
          "when": "view == dotfetchCollections && viewItem == collectionRequest",
          "group": "inline@3"
        },
        {
          "command": "dotfetch.editRequestInCollection",
          "when": "view == dotfetchCollections && viewItem == collectionRequest",
          "group": "1_actions@1"
        },
        {
          "command": "dotfetch.duplicateRequest",
          "when": "view == dotfetchCollections && viewItem == collectionRequest",
          "group": "1_actions@2"
        },
        {
          "command": "dotfetch.deleteRequestFromCollection",
          "when": "view == dotfetchCollections && viewItem == collectionRequest",
          "group": "2_danger@1"
        },
        {
          "command": "dotfetch.deleteCollection",
          "when": "view == dotfetchCollections && viewItem == collectionFolder",
          "group": "inline@1"
        },
        {
          "command": "dotfetch.deleteCollection",
          "when": "view == dotfetchCollections && viewItem == collectionFolder",
          "group": "2_danger@1"
        },
        {
          "command": "dotfetch.setActiveEnvironment",
          "when": "view == dotfetchEnvironments && viewItem == environmentFile",
          "group": "inline@1"
        },
        {
          "command": "dotfetch.setActiveEnvironment",
          "when": "view == dotfetchEnvironments && viewItem == environmentFile",
          "group": "1_actions@1"
        },
        {
          "command": "dotfetch.openEnvironmentFile",
          "when": "view == dotfetchEnvironments && viewItem == environmentFile",
          "group": "1_actions@2"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "dotfetch",
          "title": "DotFetch",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "dotfetch": [
        {
          "id": "dotfetchLaunch",
          "name": "Quick Actions",
          "icon": "media/icon.svg"
        },
        {
          "id": "dotfetchCollections",
          "name": "Collections",
          "icon": "media/icon.svg"
        },
        {
          "id": "dotfetchHistory",
          "name": "History",
          "icon": "media/icon.svg"
        },
        {
          "id": "dotfetchEnvironments",
          "name": "Environments",
          "icon": "media/icon.svg"
        }
      ]
    },
    "configuration": {
      "title": "DotFetch",
      "properties": {
        "dotfetch.timeout": {
          "type": "number",
          "default": 10000,
          "description": "Request timeout in milliseconds."
        },
        "dotfetch.maxHistory": {
          "type": "number",
          "default": 50,
          "description": "Maximum number of history items to keep."
        },
        "dotfetch.retryCount": {
          "type": "number",
          "default": 0,
          "description": "Number of times to retry a failed request."
        },
        "dotfetch.showVariablePreview": {
          "type": "boolean",
          "default": true,
          "description": "Show variable substitution preview in the editor."
        },
        "dotfetch.sslVerify": {
          "type": "boolean",
          "default": true,
          "description": "Verify SSL/TLS certificates for HTTP requests."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run esbuild-base -- --minify",
    "esbuild-base": "esbuild ./src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node && esbuild ./src/webview/main.js --bundle --outfile=media/script.js --format=iife --platform=browser",
    "compile": "npm run esbuild-base -- --sourcemap",
    "watch": "npm run esbuild-base -- --sourcemap --watch",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run typecheck && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.6.0",
    "@types/vscode": "^1.80.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.28.0",
    "eslint": "^10.2.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.58.2"
  },
  "dependencies": {
    "axios": "^1.15.0"
  }
}